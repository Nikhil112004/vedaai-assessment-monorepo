{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev --port 3000",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ../../node_modules/eslint/bin/eslint.js --max-warnings 0",
    "check-types": "node ./node_modules/next/dist/bin/next typegen && node ../../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "next": "16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.3.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.2"
  }
}
